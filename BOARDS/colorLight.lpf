# ColorLight ECP5-25K board: 25 MHz oscillator on P6.
LOCATE COMP "pclk" SITE "P6";
IOBUF PORT "pclk" IO_TYPE=LVCMOS33;
FREQUENCY PORT "pclk" 25 MHZ;

# Active-low board button is used as SoC reset.
LOCATE COMP "RESET" SITE "R7";
IOBUF PORT "RESET" PULLMODE=UP IO_TYPE=LVCMOS33;

# D1 is the onboard LED; D2-D5 are exported to connector pins.
LOCATE COMP "D1" SITE "T6";
LOCATE COMP "D2" SITE "E14";
LOCATE COMP "D3" SITE "N5";
LOCATE COMP "D4" SITE "N3";
LOCATE COMP "D5" SITE "P3";
IOBUF PORT "D1" IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "D2" IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "D3" IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "D4" IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "D5" IO_TYPE=LVCMOS33 DRIVE=8;

# OLED interface pins.
LOCATE COMP "oled_DIN" SITE "G14";
LOCATE COMP "oled_CLK" SITE "G13";
LOCATE COMP "oled_CS" SITE "F12";
LOCATE COMP "oled_DC" SITE "F13";
LOCATE COMP "oled_RST" SITE "F14";
IOBUF PORT "oled_DIN" IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "oled_CLK" IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "oled_CS" IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "oled_DC" IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "oled_RST" IO_TYPE=LVCMOS33 DRIVE=8;

# MAX7219 serial interface pins.
LOCATE COMP "ledmtx_DIN" SITE "N4";
LOCATE COMP "ledmtx_CLK" SITE "M3";
LOCATE COMP "ledmtx_CS" SITE "P4";
IOBUF PORT "ledmtx_DIN" IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "ledmtx_CLK" IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "ledmtx_CS" IO_TYPE=LVCMOS33 DRIVE=8;

# UART pins for an external USB-to-serial adapter.
LOCATE COMP "TXD" SITE "F3";
LOCATE COMP "RXD" SITE "F1";
IOBUF PORT "TXD" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "RXD" PULLMODE=UP IO_TYPE=LVCMOS33;
